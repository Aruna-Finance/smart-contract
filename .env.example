# Aruna v2 deployment env (plan U9) — copy to `.env`, fill, then `source .env`.
# `.env` is gitignored. Values below are EXAMPLES or PLACEHOLDERS. Runbook: deployments/README.md.
#
# Flow: (testnet only) SetupTestnet -> DeployFactory -> DeployMarket -> runner/run.sh.
# Two profiles share this file; the blocks marked [sandbox] / [release] show both settings.
#
# KEYS: no private key belongs in this file. Sign with a keystore (`cast wallet import rc-deployer
# --interactive`, then `--account rc-deployer`) or a hardware wallet (`--ledger`). Use SEPARATE
# keys for the RC (sandbox) and the release deployment.

# ─── network ────────────────────────────────────────────────────────────────
# Arbitrum Sepolia (RC, chainId 421614): use a DEDICATED RPC, not the public one.
# A keyed RPC URL is a secret: keep it here (gitignored) and grep broadcast/**/*.json and
# runner logs for it before committing or sharing them (older forge versions record the URL).
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# optional, for --verify:
ARBISCAN_API_KEY=

# ─── profile + manifest (DeployFactory and DeployMarket) ────────────────────
# sandbox = RC (small time scale, placeholder calibration allowed and RECORDED as placeholder)
# release = final deploy; guarded (RC manifest hash match, green ledger, real calibration)
PROFILE=sandbox                         # [release] PROFILE=release
ARUNA_DEPLOY_LABEL=sandbox              # manifest -> deployments/<chainId>/<label>.json (default = PROFILE)
GIT_COMMIT=                             # export GIT_COMMIT=$(git rev-parse HEAD); REQUIRED in release
ARUNA_MANIFEST_OVERWRITE=false          # refuse to replace an existing manifest
# DeployMarket reads this manifest (default deployments/<chainId>/<label>.json):
ARUNA_MANIFEST=
# [release] the green RC manifest whose init code hashes the release build must equal:
ARUNA_RC_MANIFEST=                      # e.g. deployments/421614/sandbox.json
# [release] conformance ledger (U10); must exist, status "green", rcManifest == ARUNA_RC_MANIFEST
ARUNA_LEDGER=conformance/ledger.json

# ─── TESTNET stand-in pool: script/Testnet.s.sol:SetupTestnet ───────────────
# Deploys mock mWETH + mUSDC, creates a REAL Uniswap v3 pool on Arbitrum Sepolia, grows
# observation cardinality and mints a SMALL LP position (safe vs uint96 position math).
# Verified Uniswap v3 infra on Arbitrum Sepolia:
#   NonfungiblePositionManager = 0x6b2937Bde17889EDCf8fbD8dE31C3C2a70Bc4d65
#   SwapRouter02               = 0x101F443B4d1b059569D643917553c771E1b9663E
#   UniswapV3Factory           = 0x248AB79Bbb9bC29bB72f7Cd42F17e054Fc40188e
ARUNA_NFPM=0x6b2937Bde17889EDCf8fbD8dE31C3C2a70Bc4d65
ARUNA_TN_FEE=3000                       # fee tier 500/3000/10000
ARUNA_TN_WETH_DEC=18
ARUNA_TN_USDC_DEC=6
ARUNA_TN_SQRT_PRICE_X96=79228162514264337593543950336   # initial sqrtPriceX96 (default 1:1 raw); set to mirror ETH
ARUNA_TN_CARDINALITY=200                # observation slots to grow to
ARUNA_TN_MINT=1000000000000000000000000000000  # 1e30 raw of each mock minted to the deployer
ARUNA_TN_LP_AMOUNT0=100000000000        # 1e11 raw into the initial (small) LP position
ARUNA_TN_LP_AMOUNT1=100000000000
# SeedSwaps (manual swap; the runner drives scenario swaps itself):
ARUNA_TN_WETH=0x0000000000000000000000000000000000000000
ARUNA_TN_USDC=0x0000000000000000000000000000000000000000
ARUNA_TN_SWAP_IN=1000000000000000000000 # 1e21 raw amountIn — big enough to move the tick
ARUNA_TN_ZERO_FOR_ONE=true

# ─── DeployFactory: chain infra + factory time parameters ───────────────────
#   Arbitrum Sepolia NFPM: 0x6b2937Bde17889EDCf8fbD8dE31C3C2a70Bc4d65
#   Arbitrum One NFPM:     0xC36442b4a4522E871399CD717aBDD847Ab11FE88
ARUNA_POSITION_MANAGER=0x6b2937Bde17889EDCf8fbD8dE31C3C2a70Bc4d65
# Settlement token. Sandbox: the mock mUSDC from SetupTestnet. Release: OPEN DECISION
# (native USDC 0xaf88d065e77c8cC2239327C5EDb3A432268e5831 vs USDC.e 0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8).
ARUNA_SETTLEMENT_TOKEN=0x0000000000000000000000000000000000000000
ARUNA_ROUTER=0x101F443B4d1b059569D643917553c771E1b9663E   # optional, recorded under manifest.infra (runner swaps)
# [sandbox] small time scale for the RC:
ARUNA_ALLOWED_TENORS=3600               # comma-separated seconds   [release] 604800,1209600,2419200 (7/14/28 days)
ARUNA_SAMPLE_INTERVAL=60                # accumulator cadence (s)   [release] 1800 (30 min, design §11.2)
ARUNA_GAP=600                           # settlement gap (s)        [release] ~86400 (1 day; final value from calibration)
# Upper bounds on per-vault keeper economics (factory-enforced):
ARUNA_MAX_KEEPER_SHARE_BPS=1000         # PLACEHOLDER
ARUNA_MAX_POKE_BOUNTY=1000000           # settlement units, PLACEHOLDER
ARUNA_MAX_FINALIZE_BOUNTY=5000000       # PLACEHOLDER
ARUNA_MAX_SETTLE_BOUNTY=2000000         # PLACEHOLDER

# ─── DeployMarket: one market (pricer + valuer + createVault) ───────────────
ARUNA_FACTORY=                          # optional cross-check against the manifest's factory
ARUNA_POOL=0x0000000000000000000000000000000000000000
ARUNA_TENOR=3600                        # must be in ARUNA_ALLOWED_TENORS   [release] 604800
ARUNA_ANCHOR=0                          # startsAt(n) = anchor + n*(tenor+gap); 0 = now + LEAD (sandbox only)
ARUNA_ANCHOR_LEAD=600                   # [release] set ARUNA_ANCHOR explicitly
ARUNA_KEEPER_BUDGET_FUNDING=0           # optional initial fundKeeperBudget donation (recorded in manifest)
# Calibration marker (R30). Explicit flag, never inferred from values:
ARUNA_CALIBRATION_PLACEHOLDER=true      # [release] MUST be false
ARUNA_CALIBRATION_ARTIFACT=sandbox-placeholder   # [release] REQUIRED: id/path of the backtest artifact

# Market parameters — ALL CALIBRATION (design §6.4/§11.2), sandbox values are PLACEHOLDERS:
ARUNA_MAX_UTIL_BPS=8000
ARUNA_MAX_EXCESS_VARIANCE=2000000000000000000   # WAD
ARUNA_EWMA_ALPHA_BPS=2000
ARUNA_SEED_VARIANCE=500000000000000000          # WAD
ARUNA_POLICY_CAP=20                     # max live policies per cohort (settle-gas bound)
ARUNA_KEEPER_SHARE_BPS=500              # <= ARUNA_MAX_KEEPER_SHARE_BPS
ARUNA_POKE_BOUNTY=10000                 # <= ARUNA_MAX_POKE_BOUNTY
ARUNA_FINALIZE_BOUNTY=50000             # <= ARUNA_MAX_FINALIZE_BOUNTY
ARUNA_SETTLE_BOUNTY=20000               # <= ARUNA_MAX_SETTLE_BOUNTY

# FlatVegaPricer (§6.3) — PLACEHOLDER
ARUNA_PRICER_MIN_PREMIUM=1000000        # settlement units
ARUNA_PRICER_LOAD_BPS=1000              # <= 5000
ARUNA_PRICER_LAMBDA=500000000000000000  # WAD
ARUNA_PRICER_M_KNOTS=0,500000000000000000,1000000000000000000,2000000000000000000,4000000000000000000
ARUNA_PRICER_G_KNOTS=1000000000000000000,600000000000000000,350000000000000000,150000000000000000,50000000000000000

# PositionValuer (§8.4) — PLACEHOLDER
ARUNA_VALUER_KAPPA=1000000000000000000  # WAD
ARUNA_VALUER_REF_WIDTH=2000             # int24 ticks, > 0
ARUNA_VALUER_MIN_WIDTH_MULT=250000000000000000   # WAD, <= WAD
ARUNA_VALUER_MAX_WIDTH_MULT=4000000000000000000  # WAD, >= WAD

# ─── runner/run.sh (live RC) ────────────────────────────────────────────────
# Wallet args per actor (keystore or hardware wallet). Two distinct underwriters for `pay`.
SIGNER_LP="--account rc-lp"
SIGNER_UW="--account rc-uw1"
SIGNER_UW2="--account rc-uw2"
SIGNER_KEEPER="--account rc-keeper"
MANIFEST=deployments/421614/sandbox.json
MARKET=0
SWAP_IN=1000000000000000000000          # raw amountIn per price-driving swap; must move the tick
LEAD_SECS=180
